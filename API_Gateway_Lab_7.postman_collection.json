    },
    {
      "name": "5 – Gateway Error Handling (502/503 Tests)",
      "item": [
        {
          "name": "POST /orders — User Service Down → 503 (via Gateway)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/orders",
              "host": ["{{gatewayUrl}}"],
              "path": ["orders"]
            },
            "description": "BEFORE running: stop the user-service container.\n  docker stop user-service\n\nExpected: Order service returns 503 (user-service unreachable).\nThe gateway proxies this 503 cleanly to the client.\n\nAFTER testing: restart the user-service.\n  docker start user-service"
          }
        },
        {
          "name": "GET /users — User Service Down → Gateway 503",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/users",
              "host": ["{{gatewayUrl}}"],
              "path": ["users"]
            },
            "description": "BEFORE running: stop the user-service container.\n  docker stop user-service\n\nExpected: Gateway returns 503 Service Unavailable (cannot reach user-service).\nThis demonstrates the gateway's centralised error handling."
          }
        },
        {
          "name": "POST /orders — After Recovery → 201 (via Gateway)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/orders",
              "host": ["{{gatewayUrl}}"],
              "path": ["orders"]
            },
            "description": "Run this AFTER restarting user-service with: docker start user-service\nExpected: 201 Created — recovery confirmed."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "description": "API Gateway base URL. Change to your cloud public URL for Part C testing (e.g. https://campusconnect-gateway.onrender.com)",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "REPLACE_WITH_ACTUAL_USER_ID",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "REPLACE_WITH_ACTUAL_PRODUCT_ID",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "REPLACE_WITH_ACTUAL_ORDER_ID",
      "type": "string"
    }
  ]
}
