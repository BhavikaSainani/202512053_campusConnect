              "raw": "{{gatewayUrl}}/users/{{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "PUT /users/:id — Update User (via Gateway)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bhavika Sainani (Updated)\",\n  \"email\": \"bhavika.updated@daiict.ac.in\",\n  \"phone\": \"9876543211\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/users/{{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "DELETE /users/:id — Delete User (via Gateway)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/users/{{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "GET /users/:id — Invalid ID (404 via Gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/users/000000000000000000000000",
              "host": ["{{gatewayUrl}}"],
              "path": ["users", "000000000000000000000000"]
            },
            "description": "Expected: 404 Not Found — gateway proxies the 404 from user-service"
          }
        }
      ]
    },
